# Plantilla sin valores reales. Copia a .env en la raíz; Git lo ignora.
# Genera las claves y el administrador inicial con: java scripts/GenerarClavesJwt.java

# Conexión a MongoDB, sin nombre de base de datos.
MONGODB_URI=mongodb://localhost:27017

# Claves RSA en Base64. La privada solo la usa ms-pacientes.
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

# URL de los servicios. En local se pueden omitir.
PACIENTES_URL=http://localhost:8081
AGENDA_URL=http://localhost:8082
HISTORIA_URL=http://localhost:8083
FARMACIA_URL=http://localhost:8084

# Recordatorios de ms-agenda (HU-030).
VETCARE_CLAVE_PROCESO=
VETCARE_CORREO_REMITENTE=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Orígenes permitidos para la interfaz web, separados por coma.
VETCARE_CORS_ORIGENES=http://localhost:5173

# Primer administrador. Solo lo usa ms-pacientes.
VETCARE_ADMIN_CORREO=
VETCARE_ADMIN_CONTRASENA=
