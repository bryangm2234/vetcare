# Plantilla sin valores reales. Copia a .env en la raíz; Git lo ignora.
# Genera las claves y el administrador inicial con: java scripts/GenerarClavesJwt.java

# Conexión a MongoDB, sin nombre de base de datos.
MONGODB_URI=mongodb://localhost:27017

# Claves RSA en Base64. La privada solo la usa ms-pacientes.
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

# Primer administrador. Solo lo usa ms-pacientes.
VETCARE_ADMIN_CORREO=
VETCARE_ADMIN_CONTRASENA=
